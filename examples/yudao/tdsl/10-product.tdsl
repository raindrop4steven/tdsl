  </form>
}

@export
function getErpProduct(id: Integer): Product {
  return Product.get(id);
}

@title('产品详情')
@menu('产品管理')
dialog erpProductDetail {
  <detail dataSource={useQuery('getErpProduct', initial.id)}>
    <text field="name" title="产品名称" />
    <text field="barCode" title="条形码" />
    <text field="salePrice" title="销售价" />
    <text field="purchasePrice" title="采购价" />
    <text field="standard" title="规格" />
    <text field="remark" title="备注" />
  </detail>
  <button text="编辑" action={openDialog('erpProductForm', row)} />
}