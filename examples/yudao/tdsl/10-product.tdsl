    <button text="保存" />
  </form>
}

@title('产品列表')
@menu('产品管理')
page erpProductList {
  <input field="name" label="产品名称" />
  <input field="categoryId" label="产品分类" />
  <input field="status" label="启用状态" />
  <table dataSource={useQuery('queryErpProduct')}>
    <column field="name" title="产品名称" />
    <column field="barCode" title="条形码" />
    <column field="categoryId" title="产品分类" />
    <column field="unitId" title="产品单位" />
    <column field="standard" title="规格型号" />
    <column field="purchasePrice" title="采购价" />
    <column field="salePrice" title="销售价" />
    <column field="status" title="启用状态" />
    <button text="编辑" action={openDialog('erpProductForm', row)} />
    <button text="删除" action={useMutation('deleteErpProduct', row.id)} />
    <button text="详情" action={openDialog('erpProductDetail', row)} />
  </table>
  <button text="新增产品" action={openDialog('erpProductForm')} />
}

@title('产品编辑')
@menu('产品管理')
dialog erpProductForm {
  <form submit={useMutation('saveErpProduct')}>
    <input field="name" label="产品名称" />
    <input field="barCode" label="条形码" />
    <input field="categoryId" label="产品分类" />
    <input field="unitId" label="产品单位" />
    <input field="standard" label="规格型号" />
    <input field="expiryDay" label="保质期天数" />
    <input field="weight" label="重量" />
    <input field="purchasePrice" label="采购价" />
    <input field="salePrice" label="销售价" />
    <input field="minPrice" label="最低售价" />
    <input field="status" label="启用状态" />
    <input field="remark" label="备注" />
