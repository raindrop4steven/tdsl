    <button text="审批" action={useMutation('auditErpPurchasePayment', row.id)} />
    <button text="反审批" action={useMutation('deauditErpPurchasePayment', row.id)} />
    <button text="详情" action={openDialog('erpPurchasePaymentDetail', row)} />
  </table>
  <button text="新增付款单" action={openDialog('erpPurchasePaymentForm')} />
}

@title('采购付款编辑')
@menu('采购管理')
dialog erpPurchasePaymentForm {
  <form submit={useMutation('saveErpPurchasePayment')}>
    <input field="no" label="付款单号" />
    <input field="paymentTime" label="付款时间" />
    <input field="supplierId" label="供应商" />
    <input field="accountId" label="结算账户" />
    <input field="financeUserId" label="财务人员" />
    <input field="discountPrice" label="优惠金额" />
    <input field="remark" label="备注" />
    <repeat field="items">
      <input field="bizType" label="核销业务类型" />
      <input field="bizId" label="关联业务单" />
      <input field="bizNo" label="关联单号" />
      <input field="totalPrice" label="应付金额" />
      <input field="paidPrice" label="已付金额" />
      <input field="paymentPrice" label="本次付款" />
      <input field="remark" label="备注" />
    </repeat>
    <button text="保存" />
  </form>
}

@export
function getErpPurchasePayment(id: Integer): FinancePayment {
  return FinancePayment.get(id);
}

@title('采购付款详情')
@menu('采购管理')
dialog erpPurchasePaymentDetail {
  <detail dataSource={useQuery('getErpPurchasePayment', initial.id)}>
    <text field="no" title="付款单号" />
    <text field="paymentTime" title="付款时间" />
    <text field="totalPrice" title="应付款金额" />
    <text field="paymentPrice" title="实付金额" />
    <text field="remark" title="备注" />
  </detail>
  <button text="编辑" action={openDialog('erpPurchasePaymentForm', row)} />
  <button text="审批" action={useMutation('auditErpPurchasePayment', row.id)} />
  <button text="反审批" action={useMutation('deauditErpPurchasePayment', row.id)} />
}