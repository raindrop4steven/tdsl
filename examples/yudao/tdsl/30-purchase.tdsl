// 芋道 ERP · 采购管理：采购订单/采购入库/采购退货/采购付款（主子表 + 审批/反审批流转 + 详情）

// ---- 采购订单 ----

@export
function queryErpPurchaseOrder(no: String, status: DocStatus, supplierId: Integer): List<PurchaseOrder> {
  return PurchaseOrder.where(no like '%' + no.trim() + '%', status = status, supplierId = supplierId).orderBy(id desc);
}

@export
function saveErpPurchaseOrder(input: PurchaseOrderInput): PurchaseOrder {
  const b = new PurchaseOrder();
  if (input.id !== null && input.id > 0) {
    const b = PurchaseOrder.get(input.id);
  }
  b.no = input.no;
  b.status = DocStatus.UNAUDIT;
  b.orderTime = input.orderTime;
  b.supplierId = input.supplierId;
  b.accountId = input.accountId;
  b.discountPercent = input.discountPercent;
  b.discountPrice = input.discountPrice;
  b.depositPrice = input.depositPrice;
  b.fileUrl = input.fileUrl;
  b.remark = input.remark;
  b.totalCount = 0;
  b.totalProductPrice = 0;
  b.totalPrice = 0;
  b.save();
  if (input.items.count > 0) {
    for (const ol of PurchaseOrderItem.where(orderId = b.id)) {
      ol.delete();
    }
    for (const it of input.items) {
      const item = new PurchaseOrderItem();
      item.orderId = b.id;
      item.productId = it.productId;
      item.productUnitId = it.productUnitId;
      item.productPrice = it.productPrice;
      item.count = it.count;
      item.totalPrice = it.productPrice * it.count;
      item.taxPercent = it.taxPercent;
      item.remark = it.remark;
      item.save();
      b.totalCount = b.totalCount + it.count;
      b.totalProductPrice = b.totalProductPrice + it.productPrice * it.count;
    }
    b.totalPrice = b.totalProductPrice - b.discountPrice;
    b.save();
  }
  return b;
}

@export
function deleteErpPurchaseOrder(id: Integer): Boolean {
  const b = PurchaseOrder.get(id);
  if (b.status === DocStatus.AUDITED) {
    throw '已审批订单不可删除';
  }
  for (const it of PurchaseOrderItem.where(orderId = id)) {
    it.delete();
  }
  b.delete();
  return true;
}

@export
function auditErpPurchaseOrder(id: Integer): Boolean {
  const b = PurchaseOrder.get(id);
  if (b.status !== DocStatus.UNAUDIT) {
    throw '仅未审批订单可审批';
  }
  b.status = DocStatus.AUDITED;
  b.save();
  return true;
}

@export
function deauditErpPurchaseOrder(id: Integer): Boolean {
  const b = PurchaseOrder.get(id);
  if (b.status !== DocStatus.AUDITED) {
    throw '仅已审批订单可反审批';
  }
  b.status = DocStatus.UNAUDIT;
  b.save();
  return true;
}

// ---- 采购入库 ----

@export
function queryErpPurchaseIn(no: String, status: DocStatus, supplierId: Integer): List<PurchaseIn> {
  return PurchaseIn.where(no like '%' + no.trim() + '%', status = status, supplierId = supplierId).orderBy(id desc);
}

@export
function saveErpPurchaseIn(input: PurchaseInInput): PurchaseIn {
  const b = new PurchaseIn();
  if (input.id !== null && input.id > 0) {
    const b = PurchaseIn.get(input.id);
  }
  b.no = input.no;
  b.status = DocStatus.UNAUDIT;
  b.inTime = input.inTime;
  b.supplierId = input.supplierId;
  b.accountId = input.accountId;
  b.orderId = input.orderId;
  b.orderNo = input.orderNo;
  b.otherPrice = input.otherPrice;
  b.fileUrl = input.fileUrl;
  b.remark = input.remark;
  b.totalCount = 0;
  b.totalProductPrice = 0;
  b.totalPrice = 0;
  b.save();
  if (input.items.count > 0) {
    for (const ol of PurchaseInItem.where(inId = b.id)) {
      ol.delete();
    }
    for (const it of input.items) {
      const item = new PurchaseInItem();
      item.inId = b.id;
      item.orderItemId = it.orderItemId;
      item.warehouseId = it.warehouseId;
      item.productId = it.productId;
      item.productUnitId = it.productUnitId;
      item.productPrice = it.productPrice;
      item.count = it.count;
      item.totalPrice = it.productPrice * it.count;
      item.taxPercent = it.taxPercent;
      item.remark = it.remark;
      item.save();
      b.totalCount = b.totalCount + it.count;
      b.totalProductPrice = b.totalProductPrice + it.productPrice * it.count;
    }
    b.discountPrice = 0;
    b.totalPrice = b.totalProductPrice - b.discountPrice + b.otherPrice;
    b.save();
  }
  return b;
}

@export
function deleteErpPurchaseIn(id: Integer): Boolean {
  const b = PurchaseIn.get(id);
  if (b.status === DocStatus.AUDITED) {
    throw '已审批入库单不可删除';
  }
  for (const it of PurchaseInItem.where(inId = id)) {
    it.delete();
  }
  b.delete();
  return true;
}

@export
function auditErpPurchaseIn(id: Integer): Boolean {
  const b = PurchaseIn.get(id);
  if (b.status !== DocStatus.UNAUDIT) {
    throw '仅未审批入库单可审批';
  }
  b.status = DocStatus.AUDITED;
  b.save();
  return true;
}

@export
function deauditErpPurchaseIn(id: Integer): Boolean {
  const b = PurchaseIn.get(id);
  if (b.status !== DocStatus.AUDITED) {
    throw '仅已审批入库单可反审批';
  }
  b.status = DocStatus.UNAUDIT;
  b.save();
  return true;
}

