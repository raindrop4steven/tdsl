// ---- 采购付款 ----

@export
function queryErpPurchasePayment(no: String, status: DocStatus, supplierId: Integer): List<FinancePayment> {
  return FinancePayment.where(no like '%' + no.trim() + '%', status = status, supplierId = supplierId).orderBy(id desc);
}

@export
function saveErpPurchasePayment(input: FinancePaymentInput): FinancePayment {
  const b = new FinancePayment();
  if (input.id !== null && input.id > 0) {
    const b = FinancePayment.get(input.id);
  }
  b.no = input.no;
  b.status = DocStatus.UNAUDIT;
  b.paymentTime = input.paymentTime;
  b.supplierId = input.supplierId;
  b.accountId = input.accountId;
  b.financeUserId = input.financeUserId;
  b.discountPrice = input.discountPrice;
  b.remark = input.remark;
  b.totalPrice = 0;
  b.paymentPrice = 0;
  b.save();
  if (input.items.count > 0) {
    for (const ol of FinancePaymentItem.where(paymentId = b.id)) {
      ol.delete();
    }
    for (const it of input.items) {
      const item = new FinancePaymentItem();
      item.paymentId = b.id;
      item.bizType = it.bizType;
      item.bizId = it.bizId;
      item.bizNo = it.bizNo;
      item.totalPrice = it.totalPrice;
      item.paidPrice = it.paidPrice;
      item.paymentPrice = it.paymentPrice;
      item.remark = it.remark;
      item.save();
      b.totalPrice = b.totalPrice + it.totalPrice;
      b.paymentPrice = b.paymentPrice + it.paymentPrice;
    }
    b.save();
  }
  return b;
}

@export
function deleteErpPurchasePayment(id: Integer): Boolean {
  const b = FinancePayment.get(id);
  if (b.status === DocStatus.AUDITED) {
    throw '已审批付款单不可删除';
  }
  for (const it of FinancePaymentItem.where(paymentId = id)) {
    it.delete();
  }
  b.delete();
  return true;
}

@export
function auditErpPurchasePayment(id: Integer): Boolean {
  const b = FinancePayment.get(id);
  if (b.status !== DocStatus.UNAUDIT) {
    throw '仅未审批付款单可审批';
  }
  b.status = DocStatus.AUDITED;
  b.save();
  return true;
}

@export
function deauditErpPurchasePayment(id: Integer): Boolean {
  const b = FinancePayment.get(id);
  if (b.status !== DocStatus.AUDITED) {
    throw '仅已审批付款单可反审批';
  }
  b.status = DocStatus.UNAUDIT;
  b.save();
  return true;
}

interface PurchaseApi {
  GET    '/api/erp/purchase-orders'            -> queryErpPurchaseOrder
  GET    '/api/erp/purchase-orders/{id}'       -> getErpPurchaseOrder
  POST   '/api/erp/purchase-orders'            -> saveErpPurchaseOrder
  DELETE '/api/erp/purchase-orders/{id}'       -> deleteErpPurchaseOrder
  POST   '/api/erp/purchase-orders/{id}/audit' -> auditErpPurchaseOrder
  POST   '/api/erp/purchase-orders/{id}/deaudit' -> deauditErpPurchaseOrder
  GET    '/api/erp/purchase-ins'               -> queryErpPurchaseIn
  GET    '/api/erp/purchase-ins/{id}'          -> getErpPurchaseIn
  POST   '/api/erp/purchase-ins'               -> saveErpPurchaseIn
  DELETE '/api/erp/purchase-ins/{id}'          -> deleteErpPurchaseIn
  POST   '/api/erp/purchase-ins/{id}/audit'    -> auditErpPurchaseIn
  POST   '/api/erp/purchase-ins/{id}/deaudit'  -> deauditErpPurchaseIn
  GET    '/api/erp/purchase-returns'           -> queryErpPurchaseReturn
  GET    '/api/erp/purchase-returns/{id}'      -> getErpPurchaseReturn
  POST   '/api/erp/purchase-returns'           -> saveErpPurchaseReturn
  DELETE '/api/erp/purchase-returns/{id}'      -> deleteErpPurchaseReturn
  POST   '/api/erp/purchase-returns/{id}/audit' -> auditErpPurchaseReturn
  POST   '/api/erp/purchase-returns/{id}/deaudit' -> deauditErpPurchaseReturn
  GET    '/api/erp/purchase-payments'          -> queryErpPurchasePayment
  GET    '/api/erp/purchase-payments/{id}'     -> getErpPurchasePayment
  POST   '/api/erp/purchase-payments'          -> saveErpPurchasePayment
  DELETE '/api/erp/purchase-payments/{id}'     -> deleteErpPurchasePayment
  POST   '/api/erp/purchase-payments/{id}/audit' -> auditErpPurchasePayment
  POST   '/api/erp/purchase-payments/{id}/deaudit' -> deauditErpPurchasePayment
}

// ---- 页面 ----

@title('采购订单列表')
@menu('采购管理')
page erpPurchaseOrderList {
  <input field="no" label="采购单号" />
  <input field="status" label="单据状态" />
  <input field="supplierId" label="供应商" />
  <table dataSource={useQuery('queryErpPurchaseOrder')}>
    <column field="no" title="采购单号" />
    <column field="status" title="单据状态" />
    <column field="orderTime" title="下单时间" />
    <column field="supplierId" title="供应商" />
    <column field="totalPrice" title="优惠后金额" />
    <column field="depositPrice" title="定金金额" />
    <button text="编辑" action={openDialog('erpPurchaseOrderForm', row)} />
    <button text="删除" action={useMutation('deleteErpPurchaseOrder', row.id)} />
    <button text="审批" action={useMutation('auditErpPurchaseOrder', row.id)} />
    <button text="反审批" action={useMutation('deauditErpPurchaseOrder', row.id)} />
    <button text="详情" action={openDialog('erpPurchaseOrderDetail', row)} />
  </table>
  <button text="新增采购订单" action={openDialog('erpPurchaseOrderForm')} />
}

@title('采购订单编辑')
@menu('采购管理')
dialog erpPurchaseOrderForm {
  <form submit={useMutation('saveErpPurchaseOrder')}>
    <input field="no" label="采购单号" />
    <input field="orderTime" label="下单时间" />
    <input field="supplierId" label="供应商" />
    <input field="accountId" label="结算账户" />
    <input field="discountPercent" label="优惠率" />
    <input field="discountPrice" label="优惠金额" />
    <input field="depositPrice" label="定金金额" />
    <input field="fileUrl" label="附件" />
    <input field="remark" label="备注" />
    <repeat field="items">
      <input field="productId" label="产品" />
      <input field="productUnitId" label="产品单位" />
      <input field="productPrice" label="产品单价" />
      <input field="count" label="数量" />
      <input field="taxPercent" label="税率" />
      <input field="remark" label="备注" />
    </repeat>
    <button text="保存" />
  </form>
}

@export
function getErpPurchaseOrder(id: Integer): PurchaseOrder {
  return PurchaseOrder.get(id);
}

@title('采购订单详情')
@menu('采购管理')
dialog erpPurchaseOrderDetail {
  <detail dataSource={useQuery('getErpPurchaseOrder', initial.id)}>
    <text field="no" title="采购单号" />
    <text field="orderTime" title="下单时间" />
    <text field="totalPrice" title="优惠后金额" />
    <text field="totalCount" title="总数量" />
    <text field="depositPrice" title="定金" />
    <text field="remark" title="备注" />
  </detail>
  <button text="编辑" action={openDialog('erpPurchaseOrderForm', row)} />
  <button text="审批" action={useMutation('auditErpPurchaseOrder', row.id)} />
  <button text="反审批" action={useMutation('deauditErpPurchaseOrder', row.id)} />
}

