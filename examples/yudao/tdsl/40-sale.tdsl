// 详情 DTO 扁平化（主表字段 + items）：详情抽屉可直接把 row 传给编辑表单做预填
struct SaleOutDetail {
  id: Integer;
  no: String;
  status: DocStatus;
  outTime: DateTime;
  customerId: Integer;
  accountId: Integer;
  saleUserId: Integer;
  orderId: Integer;
  orderNo: String;
  otherPrice: Decimal;
  fileUrl: String;
  totalPrice: Decimal;
  receiptPrice: Decimal;
  remark: String;
  items: List<SaleOutItem>;
}

@export
function getErpSaleOutDetail(id: Integer): SaleOutDetail {
  const b = SaleOut.get(id);
  const d = new SaleOutDetail();
  d.id = b.id;
  d.no = b.no;
  d.status = b.status;
  d.outTime = b.outTime;
  d.customerId = b.customerId;
  d.accountId = b.accountId;
  d.saleUserId = b.saleUserId;
  d.orderId = b.orderId;
  d.orderNo = b.orderNo;
  d.otherPrice = b.otherPrice;
  d.fileUrl = b.fileUrl;
  d.totalPrice = b.totalPrice;
  d.receiptPrice = b.receiptPrice;
  d.remark = b.remark;
  d.items = SaleOutItem.where(outId = id);
  return d;
}

