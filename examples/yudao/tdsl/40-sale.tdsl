// 芋道 ERP · 销售管理：销售订单/销售出库/销售退货/销售收款（主子表 + 审批/反审批流转 + 详情）

// ---- 销售订单 ----

@export
function queryErpSaleOrder(no: String, status: DocStatus, customerId: Integer): List<SaleOrder> {
  return SaleOrder.where(no like '%' + no.trim() + '%', status = status, customerId = customerId).orderBy(id desc);
}

@export
@ok('保存成功')
function saveErpSaleOrder(input: SaleOrderInput): SaleOrder {
  const b = new SaleOrder();
  if (input.id !== null && input.id > 0) {
    const b = SaleOrder.get(input.id);
  }
  b.no = input.no;
  b.status = DocStatus.UNAUDIT;
  b.orderTime = input.orderTime;
  b.customerId = input.customerId;
  b.accountId = input.accountId;
  b.saleUserId = input.saleUserId;
  b.discountPercent = input.discountPercent;
  b.discountPrice = input.discountPrice;
  b.depositPrice = input.depositPrice;
  b.fileUrl = input.fileUrl;
  b.remark = input.remark;
  b.totalCount = 0;
  b.totalProductPrice = 0;
  b.totalPrice = 0;
  b.save();
  if (input.items.count > 0) {
    for (const ol of SaleOrderItem.where(orderId = b.id)) {
      ol.delete();
    }
    for (const it of input.items) {
      const item = new SaleOrderItem();
      item.orderId = b.id;
      item.productId = it.productId;
      item.productUnitId = it.productUnitId;
      item.productPrice = it.productPrice;
      item.count = it.count;
      item.totalPrice = it.productPrice * it.count;
      item.taxPercent = it.taxPercent;
      item.remark = it.remark;
      item.save();
      b.totalCount = b.totalCount + it.count;
      b.totalProductPrice = b.totalProductPrice + it.productPrice * it.count;
    }
    b.totalPrice = b.totalProductPrice - b.discountPrice;
    b.save();
  }
  return b;
}

@export
@ok('删除成功')
function deleteErpSaleOrder(id: Integer): Boolean {
  const b = SaleOrder.get(id);
  if (b.status === DocStatus.AUDITED) {
    throw '已审批订单不可删除';
  }
  for (const it of SaleOrderItem.where(orderId = id)) {
    it.delete();
  }
  b.delete();
  return true;
}

@export
@ok('审批完成')
function auditErpSaleOrder(id: Integer): Boolean {
  const b = SaleOrder.get(id);
  if (b.status !== DocStatus.UNAUDIT) {
    throw '仅未审批订单可审批';
  }
  b.status = DocStatus.AUDITED;
  b.save();
  return true;
}

@export
@ok('已反审批')
function deauditErpSaleOrder(id: Integer): Boolean {
  const b = SaleOrder.get(id);
  if (b.status !== DocStatus.AUDITED) {
    throw '仅已审批订单可反审批';
  }
  b.status = DocStatus.UNAUDIT;
  b.save();
  return true;
}

// ---- 销售出库 ----

@export
function queryErpSaleOut(no: String, status: DocStatus, customerId: Integer): List<SaleOut> {
  return SaleOut.where(no like '%' + no.trim() + '%', status = status, customerId = customerId).orderBy(id desc);
}

@export
@ok('保存成功')
function saveErpSaleOut(input: SaleOutInput): SaleOut {
  const b = new SaleOut();
  if (input.id !== null && input.id > 0) {
    const b = SaleOut.get(input.id);
  }
  b.no = input.no;
  b.status = DocStatus.UNAUDIT;
  b.outTime = input.outTime;
  b.customerId = input.customerId;
  b.accountId = input.accountId;
  b.saleUserId = input.saleUserId;
  b.orderId = input.orderId;
  b.orderNo = input.orderNo;
  b.otherPrice = input.otherPrice;
  b.fileUrl = input.fileUrl;
  b.remark = input.remark;
  b.totalCount = 0;
  b.totalProductPrice = 0;
  b.totalPrice = 0;
  b.save();
  if (input.items.count > 0) {
    for (const ol of SaleOutItem.where(outId = b.id)) {
      ol.delete();
    }
    for (const it of input.items) {
      const item = new SaleOutItem();
      item.outId = b.id;
      item.warehouseId = it.warehouseId;
      item.productId = it.productId;
      item.productUnitId = it.productUnitId;
      item.productPrice = it.productPrice;
      item.count = it.count;
      item.totalPrice = it.productPrice * it.count;
      item.taxPercent = it.taxPercent;
      item.remark = it.remark;
      item.save();
      b.totalCount = b.totalCount + it.count;
      b.totalProductPrice = b.totalProductPrice + it.productPrice * it.count;
    }
    b.discountPrice = 0;
    b.totalPrice = b.totalProductPrice - b.discountPrice + b.otherPrice;
    b.save();
  }
  return b;
}

@export
@ok('删除成功')
function deleteErpSaleOut(id: Integer): Boolean {
  const b = SaleOut.get(id);
  if (b.status === DocStatus.AUDITED) {
    throw '已审批出库单不可删除';
  }
  for (const it of SaleOutItem.where(outId = id)) {
    it.delete();
  }
  b.delete();
  return true;
}

@export
@ok('审批完成')
function auditErpSaleOut(id: Integer): Boolean {
  const b = SaleOut.get(id);
  if (b.status !== DocStatus.UNAUDIT) {
    throw '仅未审批出库单可审批';
  }
  // 库存联动：校验后逐明细出库（不足抛错回滚）
  for (const it of SaleOutItem.where(outId = id)) {
    applyStock(it.productId, it.warehouseId, 0 - it.count, StockRecordBizType.SALE_OUT, id, b.no);
  }
  // 回写来源销售订单：明细已出库数 + 订单累计；累计到总量 → 订单完成
  if (b.orderId !== null) {
    const order = SaleOrder.get(b.orderId);
    for (const it of SaleOutItem.where(outId = id)) {
      const oi = SaleOrderItem.where(orderId = b.orderId, productId = it.productId);
      for (const o of oi) {
        if (o.outCount === null) {
          o.outCount = it.count;
        } else {
          o.outCount = o.outCount + it.count;
        }
        o.save();
      }
      if (order.outCount === null) {
        order.outCount = it.count;
      } else {
        order.outCount = order.outCount + it.count;
      }
    }
    if (order.totalCount !== null && order.outCount >= order.totalCount) {
      order.status = DocStatus.AUDITED;
    }
    order.save();
  }
  b.status = DocStatus.AUDITED;
  b.save();
  return true;
}

@export
@ok('已反审批')
function deauditErpSaleOut(id: Integer): Boolean {
  const b = SaleOut.get(id);
  if (b.status !== DocStatus.AUDITED) {
    throw '仅已审批出库单可反审批';
  }
  for (const it of SaleOutItem.where(outId = id)) {
    applyStock(it.productId, it.warehouseId, it.count, StockRecordBizType.SALE_OUT_CANCEL, id, b.no);
  }
  if (b.orderId !== null) {
    const order = SaleOrder.get(b.orderId);
    for (const it of SaleOutItem.where(outId = id)) {
      for (const o of SaleOrderItem.where(orderId = b.orderId, productId = it.productId)) {
        if (o.outCount !== null) {
          o.outCount = o.outCount - it.count;
        }
        o.save();
      }
      if (order.outCount !== null) {
        order.outCount = order.outCount - it.count;
      }
    }
    order.status = DocStatus.UNAUDIT;
    order.save();
  }
  b.status = DocStatus.UNAUDIT;
  b.save();
  return true;
}

// ---- 销售退货 ----

