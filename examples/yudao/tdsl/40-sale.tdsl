function queryErpSaleReturn(no: String, status: DocStatus, customerId: Integer): List<SaleReturn> {
  return SaleReturn.where(no like '%' + no.trim() + '%', status = status, customerId = customerId).orderBy(id desc);
}

@export
@ok('保存成功')
function saveErpSaleReturn(input: SaleReturnInput): SaleReturn {
  const b = new SaleReturn();
  if (input.id !== null && input.id > 0) {
    const b = SaleReturn.get(input.id);
  }
  b.no = input.no;
  b.status = DocStatus.UNAUDIT;
  b.returnTime = input.returnTime;
  b.customerId = input.customerId;
  b.accountId = input.accountId;
  b.saleUserId = input.saleUserId;
  b.orderId = input.orderId;
  b.orderNo = input.orderNo;
  b.otherPrice = input.otherPrice;
  b.fileUrl = input.fileUrl;
  b.remark = input.remark;
  b.totalCount = 0;
  b.totalProductPrice = 0;
  b.totalPrice = 0;
  b.save();
  if (input.items.count > 0) {
    for (const ol of SaleReturnItem.where(returnId = b.id)) {
      ol.delete();
    }
    for (const it of input.items) {
      const item = new SaleReturnItem();
      item.returnId = b.id;
      item.warehouseId = it.warehouseId;
      item.productId = it.productId;
      item.productUnitId = it.productUnitId;
      item.productPrice = it.productPrice;
      item.count = it.count;
      item.totalPrice = it.productPrice * it.count;
      item.taxPercent = it.taxPercent;
      item.remark = it.remark;
      item.save();
      b.totalCount = b.totalCount + it.count;
      b.totalProductPrice = b.totalProductPrice + it.productPrice * it.count;
    }
    b.discountPrice = 0;
    b.totalPrice = b.totalProductPrice - b.discountPrice + b.otherPrice;
    b.save();
  }
  return b;
}

@export
@ok('删除成功')
function deleteErpSaleReturn(id: Integer): Boolean {
  const b = SaleReturn.get(id);
  if (b.status === DocStatus.AUDITED) {
    throw '已审批退货单不可删除';
  }
  for (const it of SaleReturnItem.where(returnId = id)) {
    it.delete();
  }
  b.delete();
  return true;
}

@export
@ok('审批完成')
function auditErpSaleReturn(id: Integer): Boolean {
  const b = SaleReturn.get(id);
  if (b.status !== DocStatus.UNAUDIT) {
    throw '仅未审批退货单可审批';
  }
  // 库存联动：销售退货入库
  for (const it of SaleReturnItem.where(returnId = id)) {
    applyStock(it.productId, it.warehouseId, it.count, StockRecordBizType.SALE_RETURN, id, b.no);
  }
  b.status = DocStatus.AUDITED;
  b.save();
  return true;
}

@export
@ok('已反审批')
function deauditErpSaleReturn(id: Integer): Boolean {
  const b = SaleReturn.get(id);
  if (b.status !== DocStatus.AUDITED) {
    throw '仅已审批退货单可反审批';
  }
  for (const it of SaleReturnItem.where(returnId = id)) {
    applyStock(it.productId, it.warehouseId, 0 - it.count, StockRecordBizType.SALE_RETURN_CANCEL, id, b.no);
  }
  b.status = DocStatus.UNAUDIT;
  b.save();
  return true;
}

// ---- 销售收款 ----

@export
function queryErpSaleReceipt(no: String, status: DocStatus, customerId: Integer): List<FinanceReceipt> {
  return FinanceReceipt.where(no like '%' + no.trim() + '%', status = status, customerId = customerId).orderBy(id desc);
}

@export
@ok('保存成功')
function saveErpSaleReceipt(input: FinanceReceiptInput): FinanceReceipt {
  const b = new FinanceReceipt();
  if (input.id !== null && input.id > 0) {
    const b = FinanceReceipt.get(input.id);
  }
  b.no = input.no;
  b.status = DocStatus.UNAUDIT;
  b.receiptTime = input.receiptTime;
  b.customerId = input.customerId;
  b.accountId = input.accountId;
  b.financeUserId = input.financeUserId;
  b.discountPrice = input.discountPrice;
  b.remark = input.remark;
  b.totalPrice = 0;
  b.receiptPrice = 0;
  b.save();
  if (input.items.count > 0) {
    for (const ol of FinanceReceiptItem.where(receiptId = b.id)) {
      ol.delete();
    }
    for (const it of input.items) {
      const item = new FinanceReceiptItem();
      item.receiptId = b.id;
      item.bizType = it.bizType;
      item.bizId = it.bizId;
      item.bizNo = it.bizNo;
      item.totalPrice = it.totalPrice;
      item.receiptedPrice = it.receiptedPrice;
      item.receiptPrice = it.receiptPrice;
      item.remark = it.remark;
      item.save();
      b.totalPrice = b.totalPrice + it.totalPrice;
      b.receiptPrice = b.receiptPrice + it.receiptPrice;
    }
    b.save();
  }
  return b;
}

@export
@ok('删除成功')
function deleteErpSaleReceipt(id: Integer): Boolean {
  const b = FinanceReceipt.get(id);
  if (b.status === DocStatus.AUDITED) {
    throw '已审批收款单不可删除';
  }
  for (const it of FinanceReceiptItem.where(receiptId = id)) {
    it.delete();
  }
  b.delete();
  return true;
}

@export
@ok('审批完成')
function auditErpSaleReceipt(id: Integer): Boolean {
  const b = FinanceReceipt.get(id);
  if (b.status !== DocStatus.UNAUDIT) {
    throw '仅未审批收款单可审批';
  }
  // 核销：按明细关联单号回写出库单已收金额
  for (const it of FinanceReceiptItem.where(receiptId = id)) {
    for (const got of SaleOut.where(no = it.bizNo)) {
      if (got.receiptPrice === null) {
        got.receiptPrice = it.receiptPrice;
      } else {
        got.receiptPrice = got.receiptPrice + it.receiptPrice;
      }
      got.save();
    }
  }
  b.status = DocStatus.AUDITED;
  b.save();
  return true;
}

@export
@ok('已反审批')
function deauditErpSaleReceipt(id: Integer): Boolean {
  const b = FinanceReceipt.get(id);
  if (b.status !== DocStatus.AUDITED) {
    throw '仅已审批收款单可反审批';
  }
  for (const it of FinanceReceiptItem.where(receiptId = id)) {
    for (const got of SaleOut.where(no = it.bizNo)) {
      if (got.receiptPrice !== null) {
        got.receiptPrice = got.receiptPrice - it.receiptPrice;
      }
      got.save();
    }
  }
  b.status = DocStatus.UNAUDIT;
  b.save();
  return true;
}

interface SaleApi {
  GET    '/api/erp/sale-orders'             -> queryErpSaleOrder
  GET    '/api/erp/sale-orders/{id}'        -> getErpSaleOrder
  POST   '/api/erp/sale-orders'             -> saveErpSaleOrder
  DELETE '/api/erp/sale-orders/{id}'        -> deleteErpSaleOrder
  POST   '/api/erp/sale-orders/{id}/audit'  -> auditErpSaleOrder
  POST   '/api/erp/sale-orders/{id}/deaudit' -> deauditErpSaleOrder
  GET    '/api/erp/sale-outs'               -> queryErpSaleOut
  GET    '/api/erp/sale-outs/{id}/detail'   -> getErpSaleOutDetail
  POST   '/api/erp/sale-outs'               -> saveErpSaleOut
  DELETE '/api/erp/sale-outs/{id}'          -> deleteErpSaleOut
  POST   '/api/erp/sale-outs/{id}/audit'    -> auditErpSaleOut
  POST   '/api/erp/sale-outs/{id}/deaudit'  -> deauditErpSaleOut
  GET    '/api/erp/sale-returns'            -> queryErpSaleReturn
  GET    '/api/erp/sale-returns/{id}'       -> getErpSaleReturn
  POST   '/api/erp/sale-returns'            -> saveErpSaleReturn
  DELETE '/api/erp/sale-returns/{id}'       -> deleteErpSaleReturn
  POST   '/api/erp/sale-returns/{id}/audit' -> auditErpSaleReturn
  POST   '/api/erp/sale-returns/{id}/deaudit' -> deauditErpSaleReturn
  GET    '/api/erp/sale-receipts'           -> queryErpSaleReceipt
  GET    '/api/erp/sale-receipts/{id}'      -> getErpSaleReceipt
  POST   '/api/erp/sale-receipts'           -> saveErpSaleReceipt
  DELETE '/api/erp/sale-receipts/{id}'      -> deleteErpSaleReceipt
  POST   '/api/erp/sale-receipts/{id}/audit' -> auditErpSaleReceipt
  POST   '/api/erp/sale-receipts/{id}/deaudit' -> deauditErpSaleReceipt
}

// ---- 页面 ----

@title('销售订单列表')
@menu('销售管理')
page erpSaleOrderList {
  <input field="no" label="销售单号" />
  <input field="status" label="单据状态" />
  <input field="customerId" label="客户" />
  <table dataSource={useQuery('queryErpSaleOrder')}>
    <column field="no" title="销售单号" />
    <column field="status" title="单据状态" />
    <column field="orderTime" title="下单时间" />
    <column field="customerId" title="客户" />
    <column field="totalPrice" title="优惠后金额" />
    <column field="depositPrice" title="定金金额" />
    <button text="编辑" action={openDialog('erpSaleOrderForm', row)}
            disabled={row.status === DocStatus.AUDITED} />
    <button text="删除" action={useMutation('deleteErpSaleOrder', row.id)} />
    <button text="审批" action={useMutation('auditErpSaleOrder', row.id)}
            visible={row.status === DocStatus.UNAUDIT} />
    <button text="反审批" action={useMutation('deauditErpSaleOrder', row.id)}
            visible={row.status === DocStatus.AUDITED} />
    <button text="详情" action={openDialog('erpSaleOrderDetail', row)} />
  </table>
  <button text="新增销售订单" action={openDialog('erpSaleOrderForm')} />
}

@title('销售订单编辑')
@menu('销售管理')
dialog erpSaleOrderForm {
  <form submit={useMutation('saveErpSaleOrder')}>
    <input field="no" label="销售单号" />
    <input field="orderTime" label="下单时间" />
    <input field="customerId" label="客户" />
    <input field="accountId" label="结算账户" />
    <input field="saleUserId" label="销售员" />
    <input field="discountPercent" label="优惠率" />
    <input field="discountPrice" label="优惠金额" />
    <input field="depositPrice" label="定金金额" />
    <input field="fileUrl" label="附件" />
    <input field="remark" label="备注" />
    <repeat field="items">
      <input field="productId" label="产品" />
      <input field="productUnitId" label="产品单位" />
      <input field="productPrice" label="产品单价" />
      <input field="count" label="数量" />
      <input field="taxPercent" label="税率" />
      <input field="remark" label="备注" />
    </repeat>
    <button text="保存" />
  </form>
}

