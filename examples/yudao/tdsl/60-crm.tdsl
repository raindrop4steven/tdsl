            visible={row.ownerUserId !== 0 && row.lockStatus === LockStatus.UNLOCKED} />
    <button text="解锁" action={useMutation('unlockCrmCustomer', row.id)}
            visible={row.lockStatus === LockStatus.LOCKED} />
    <button text="详情" action={openDialog('crmCustomerDetail', row)} />
