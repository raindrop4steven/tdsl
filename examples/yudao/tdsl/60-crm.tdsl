// 芋道 CRM：线索/客户/联系人/公海/商机/合同/回款/产品/跟进记录/待办事项

// ---- 线索 ----

@export
function queryCrmClue(name: String, mobile: String, followUpStatus: FollowUpStatus, level: Integer, source: Integer): List<CrmClue> {
  return CrmClue.where(name like '%' + name.trim() + '%', mobile like '%' + mobile.trim() + '%', followUpStatus = followUpStatus, level = level, source = source).orderBy(id desc);
}

@export
@ok('保存成功')
function saveCrmClue(input: CrmClueInput): CrmClue {
  const c = new CrmClue();
  if (input.id !== null && input.id > 0) {
    const c = CrmClue.get(input.id);
  }
  c.name = input.name;
  c.ownerUserId = input.ownerUserId;
  c.followUpStatus = FollowUpStatus.UNFOLLOWED;
  c.transformStatus = TransformStatus.UNTRANSFORMED;
  c.mobile = input.mobile;
  c.telephone = input.telephone;
  c.qq = input.qq;
  c.wechat = input.wechat;
  c.email = input.email;
  c.areaId = input.areaId;
  c.detailAddress = input.detailAddress;
  c.industryId = input.industryId;
  c.level = input.level;
  c.source = input.source;
  c.remark = input.remark;
  c.save();
  return c;
}

@export
@ok('删除成功')
function deleteCrmClue(id: Integer): Boolean {
  const c = CrmClue.get(id);
  c.delete();
  return true;
}

// 转化为客户：建客户 + 线索置已转化（链式写）
@export
@ok('已转化')
function transformCrmClue(id: Integer): CrmCustomer {
  const clue = CrmClue.get(id);
  if (clue.transformStatus === TransformStatus.TRANSFORMED) {
    throw '线索已转化';
  }
  const c = new CrmCustomer();
  c.name = clue.name;
  c.ownerUserId = clue.ownerUserId;
  c.lockStatus = LockStatus.UNLOCKED;
  c.dealStatus = DealStatus.UNDEALED;
  c.followUpStatus = FollowUpStatus.UNFOLLOWED;
  c.mobile = clue.mobile;
  c.telephone = clue.telephone;
  c.qq = clue.qq;
  c.wechat = clue.wechat;
  c.email = clue.email;
  c.areaId = clue.areaId;
  c.detailAddress = clue.detailAddress;
  c.industryId = clue.industryId;
  c.level = clue.level;
  c.source = clue.source;
  c.remark = clue.remark;
  c.save();
  clue.transformStatus = TransformStatus.TRANSFORMED;
  clue.customerId = c.id;
  clue.save();
  return c;
}

// ---- 客户 ----

@export
function queryCrmCustomer(name: String, mobile: String, level: Integer, source: Integer, dealStatus: DealStatus): List<CrmCustomer> {
  return CrmCustomer.where(name like '%' + name.trim() + '%', mobile like '%' + mobile.trim() + '%', level = level, source = source, dealStatus = dealStatus).orderBy(id desc);
}

@export
@ok('保存成功')
function saveCrmCustomer(input: CrmCustomerInput): CrmCustomer {
  const c = new CrmCustomer();
  if (input.id !== null && input.id > 0) {
    const c = CrmCustomer.get(input.id);
  }
  c.name = input.name;
  c.ownerUserId = input.ownerUserId;
  if (c.lockStatus === null) {
    c.lockStatus = LockStatus.UNLOCKED;
  }
  if (c.dealStatus === null) {
    c.dealStatus = DealStatus.UNDEALED;
  }
  c.followUpStatus = FollowUpStatus.UNFOLLOWED;
  c.mobile = input.mobile;
  c.telephone = input.telephone;
  c.qq = input.qq;
  c.wechat = input.wechat;
  c.email = input.email;
  c.areaId = input.areaId;
  c.detailAddress = input.detailAddress;
  c.industryId = input.industryId;
  c.level = input.level;
  c.source = input.source;
  c.remark = input.remark;
  c.save();
  return c;
}

@export
@ok('删除成功')
function deleteCrmCustomer(id: Integer): Boolean {
  const c = CrmCustomer.get(id);
  c.delete();
  return true;
}

// 放入公海：清空负责人并解锁
@export
@ok('已放入公海')
function putCrmCustomerToPool(id: Integer): Boolean {
  const c = CrmCustomer.get(id);
  if (c.ownerUserId === 0) {
    throw '该客户已在公海';
  }
  if (c.lockStatus === LockStatus.LOCKED) {
    throw '客户已锁定，请先解锁';
  }
  c.ownerUserId = 0;
  c.ownerTime = null;
  c.lockStatus = LockStatus.UNLOCKED;
  c.dealStatus = DealStatus.UNDEALED;
  c.save();
  return true;
}

@export
@ok('已领取')
function takeCrmCustomerFromPool(id: Integer): Boolean {
  const c = CrmCustomer.get(id);
  if (c.ownerUserId !== 0) {
    throw '该客户已有负责人，不能领取';
  }
  if (c.lockStatus === LockStatus.LOCKED) {
    throw '客户已锁定，不能领取';
  }
  c.ownerUserId = 1;
  c.ownerTime = DateTime.now();
  c.lockStatus = LockStatus.UNLOCKED;
  c.save();
  return true;
}

@export
@ok('已锁定')
function lockCrmCustomer(id: Integer): Boolean {
  const c = CrmCustomer.get(id);
  if (c.ownerUserId === 0) {
    throw '公海客户不能锁定，请先领取';
  }
  c.lockStatus = LockStatus.LOCKED;
  c.save();
  return true;
}

@export
@ok('已解锁')
function unlockCrmCustomer(id: Integer): Boolean {
  const c = CrmCustomer.get(id);
  c.lockStatus = LockStatus.UNLOCKED;
  c.save();
  return true;
}

@export
@ok('已分配')
function assignCrmCustomer(id: Integer): Boolean {
  const c = CrmCustomer.get(id);
  if (c.lockStatus === LockStatus.LOCKED) {
    throw '客户已锁定，请先解锁再分配';
  }
  c.ownerUserId = 1;
  c.ownerTime = DateTime.now();
  c.save();
  return true;
}

