// ---- 商机 ----

@export
function queryCrmBusiness(name: String, customerId: Integer, statusId: Integer, endStatus: BusinessEndStatus): List<CrmBusiness> {
  return CrmBusiness.where(name like '%' + name.trim() + '%', customerId = customerId, statusId = statusId, endStatus = endStatus).orderBy(id desc);
}

@export
@ok('保存成功')
function saveCrmBusiness(input: CrmBusinessInput): CrmBusiness {
  const b = new CrmBusiness();
  if (input.id !== null && input.id > 0) {
    const b = CrmBusiness.get(input.id);
  }
  b.name = input.name;
  b.customerId = input.customerId;
  b.ownerUserId = input.ownerUserId;
  b.followUpStatus = FollowUpStatus.UNFOLLOWED;
  b.statusTypeId = input.statusTypeId;
  b.statusId = input.statusId;
  b.discountPercent = input.discountPercent;
  b.remark = input.remark;
  b.totalProductPrice = 0;
  b.totalPrice = 0;
  b.save();
  if (input.products.count > 0) {
    for (const ol of CrmBusinessProduct.where(businessId = b.id)) {
      ol.delete();
    }
    for (const it of input.products) {
      const prod = new CrmBusinessProduct();
      prod.businessId = b.id;
      prod.productId = it.productId;
      prod.productPrice = it.productPrice;
      prod.businessPrice = it.businessPrice;
      prod.count = it.count;
      prod.totalPrice = it.businessPrice * it.count;
      prod.save();
      b.totalProductPrice = b.totalProductPrice + it.businessPrice * it.count;
    }
    b.totalPrice = b.totalProductPrice - b.discountPercent * b.totalProductPrice / 100;
    b.save();
  }
  return b;
}

@export
@ok('删除成功')
function deleteCrmBusiness(id: Integer): Boolean {
  const b = CrmBusiness.get(id);
  for (const it of CrmBusinessProduct.where(businessId = id)) {
    it.delete();
  }
  b.delete();
  return true;
}

// 赢单：商机置赢 + 联动客户成交（链式写）
@export
@ok('已标记赢单')
function winCrmBusiness(id: Integer): Boolean {
  const b = CrmBusiness.get(id);
  b.endStatus = BusinessEndStatus.WIN;
  b.save();
  const c = CrmCustomer.get(b.customerId);
  c.dealStatus = DealStatus.DEALED;
  c.save();
  return true;
}

@export
@ok('已标记输单')
function loseCrmBusiness(id: Integer): Boolean {
  const b = CrmBusiness.get(id);
  b.endStatus = BusinessEndStatus.LOSE;
  b.save();
  return true;
}

@export
@ok('已标记无效')
function invalidateCrmBusiness(id: Integer): Boolean {
  const b = CrmBusiness.get(id);
  b.endStatus = BusinessEndStatus.INVALID;
  b.save();
  return true;
}

@export
function changeCrmBusinessStage(input: CrmBusinessStageInput): CrmBusiness {
  const b = CrmBusiness.get(input.statusId);
  b.statusTypeId = input.statusTypeId;
  b.statusId = input.statusId;
  b.save();
  return b;
}

// ---- 合同 ----

@export
function queryCrmContract(no: String, customerId: Integer, auditStatus: CrmAuditStatus): List<CrmContract> {
  return CrmContract.where(no like '%' + no.trim() + '%', customerId = customerId, auditStatus = auditStatus).orderBy(id desc);
}

@export
@ok('保存成功')
function saveCrmContract(input: CrmContractInput): CrmContract {
  const c = new CrmContract();
  if (input.id !== null && input.id > 0) {
    const c = CrmContract.get(input.id);
  }
  c.name = input.name;
  c.no = input.no;
  c.customerId = input.customerId;
  c.businessId = input.businessId;
  c.ownerUserId = input.ownerUserId;
  c.auditStatus = CrmAuditStatus.UNSUBMIT;
  c.orderDate = input.orderDate;
  c.startTime = input.startTime;
  c.endTime = input.endTime;
  c.signContactId = input.signContactId;
  c.signUserId = input.signUserId;
  c.discountPercent = input.discountPercent;
  c.remark = input.remark;
  c.totalProductPrice = 0;
  c.totalPrice = 0;
  c.save();
  if (input.products.count > 0) {
    for (const ol of CrmContractProduct.where(contractId = c.id)) {
      ol.delete();
    }
    for (const it of input.products) {
      const prod = new CrmContractProduct();
      prod.contractId = c.id;
      prod.productId = it.productId;
      prod.productPrice = it.productPrice;
      prod.contractPrice = it.contractPrice;
      prod.count = it.count;
      prod.totalPrice = it.contractPrice * it.count;
      prod.save();
      c.totalProductPrice = c.totalProductPrice + it.contractPrice * it.count;
    }
    c.totalPrice = c.totalProductPrice - c.discountPercent * c.totalProductPrice / 100;
    c.save();
  }
  return c;
}

@export
@ok('删除成功')
function deleteCrmContract(id: Integer): Boolean {
  const c = CrmContract.get(id);
  for (const it of CrmContractProduct.where(contractId = id)) {
    it.delete();
  }
  c.delete();
  return true;
}

@export
@ok('已提交')
function submitCrmContract(id: Integer): Boolean {
  const c = CrmContract.get(id);
  c.auditStatus = CrmAuditStatus.UNDER_REVIEW;
  c.save();
  return true;
}

@export
@ok('审批通过')
function approveCrmContract(id: Integer): Boolean {
  const c = CrmContract.get(id);
  c.auditStatus = CrmAuditStatus.APPROVED;
  c.save();
  return true;
}

@export
@ok('已驳回')
function rejectCrmContract(id: Integer): Boolean {
  const c = CrmContract.get(id);
  c.auditStatus = CrmAuditStatus.REJECTED;
  c.save();
  return true;
}

