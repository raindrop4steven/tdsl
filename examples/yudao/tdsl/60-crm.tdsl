  return SourceDict.all;
}

@export
function queryIndustryDict(): List<IndustryDict> {
  return IndustryDict.all;
}

@export
function queryAreaDict(): List<AreaDict> {
  return AreaDict.all;
}

@export
@ok('保存成功')
function saveSourceDict(input: SourceDictInput): SourceDict {
  const s = new SourceDict();
  if (input.id !== null && input.id > 0) {
    const s = SourceDict.get(input.id);
  }
  s.name = input.name;
  s.save();
  return s;
}

@export
@ok('保存成功')
function saveIndustryDict(input: IndustryDictInput): IndustryDict {
  const s = new IndustryDict();
  if (input.id !== null && input.id > 0) {
    const s = IndustryDict.get(input.id);
  }
  s.name = input.name;
  s.save();
  return s;
}

@export
@ok('保存成功')
function saveAreaDict(input: AreaDictInput): AreaDict {
  const s = new AreaDict();
  if (input.id !== null && input.id > 0) {
    const s = AreaDict.get(input.id);
  }
  s.name = input.name;
  s.save();
  return s;
}

// ---- 系统用户（@ref 配套：负责人/销售员来源） ----

@export
function querySystemUser(): List<SystemUser> {
  return SystemUser.all;
}

@export
@ok('保存成功')
function saveSystemUser(input: SystemUserInput): SystemUser {
  const u = new SystemUser();
  if (input.id !== null && input.id > 0) {
    const u = SystemUser.get(input.id);
  }
  u.username = input.username;
  u.nickname = input.nickname;
  u.save();
  return u;
}

interface CrmApi {
  GET    '/api/users'                     -> querySystemUser
  POST   '/api/users'                     -> saveSystemUser
  GET    '/api/crm/source-dicts'          -> querySourceDict
  POST   '/api/crm/source-dicts'          -> saveSourceDict
  GET    '/api/crm/industry-dicts'        -> queryIndustryDict
  POST   '/api/crm/industry-dicts'        -> saveIndustryDict
  GET    '/api/crm/area-dicts'            -> queryAreaDict
  POST   '/api/crm/area-dicts'            -> saveAreaDict
  GET    '/api/crm/clues'                 -> queryCrmClue
  GET    '/api/crm/clues/{id}'            -> getCrmClue
  POST   '/api/crm/clues'                 -> saveCrmClue
  DELETE '/api/crm/clues/{id}'            -> deleteCrmClue
  POST   '/api/crm/clues/{id}/transform'  -> transformCrmClue
  GET    '/api/crm/customers'             -> queryCrmCustomer
  GET    '/api/crm/customers/{id}'        -> getCrmCustomer
  POST   '/api/crm/customers'             -> saveCrmCustomer
  DELETE '/api/crm/customers/{id}'        -> deleteCrmCustomer
  POST   '/api/crm/customers/{id}/pool'   -> putCrmCustomerToPool
  POST   '/api/crm/customers/{id}/take'   -> takeCrmCustomerFromPool
  POST   '/api/crm/customers/{id}/lock'   -> lockCrmCustomer
  POST   '/api/crm/customers/{id}/unlock' -> unlockCrmCustomer
  POST   '/api/crm/customers/{id}/assign' -> assignCrmCustomer
  GET    '/api/crm/contacts'              -> queryCrmContact
  POST   '/api/crm/contacts'              -> saveCrmContact
  DELETE '/api/crm/contacts/{id}'         -> deleteCrmContact
  GET    '/api/crm/pool-config'           -> queryCrmCustomerPoolConfig
  POST   '/api/crm/pool-config'           -> saveCrmCustomerPoolConfig
  GET    '/api/crm/limit-config'          -> queryCrmCustomerLimitConfig
  POST   '/api/crm/limit-config'          -> saveCrmCustomerLimitConfig
  DELETE '/api/crm/limit-config/{id}'     -> deleteCrmCustomerLimitConfig
  GET    '/api/crm/business-status-types' -> queryCrmBusinessStatusType
  POST   '/api/crm/business-status-types' -> saveCrmBusinessStatusType
  DELETE '/api/crm/business-status-types/{id}' -> deleteCrmBusinessStatusType
  GET    '/api/crm/business-statuses'     -> queryCrmBusinessStatus
  POST   '/api/crm/business-statuses'     -> saveCrmBusinessStatus
  DELETE '/api/crm/business-statuses/{id}' -> deleteCrmBusinessStatus
  GET    '/api/crm/businesses'            -> queryCrmBusiness
  GET    '/api/crm/businesses/{id}'       -> getCrmBusiness
  POST   '/api/crm/businesses'            -> saveCrmBusiness
  DELETE '/api/crm/businesses/{id}'       -> deleteCrmBusiness
  POST   '/api/crm/businesses/{id}/win'   -> winCrmBusiness
  POST   '/api/crm/businesses/{id}/lose'  -> loseCrmBusiness
  POST   '/api/crm/businesses/{id}/invalid' -> invalidateCrmBusiness
  POST   '/api/crm/businesses/stage'       -> changeCrmBusinessStage
  GET    '/api/crm/contracts'             -> queryCrmContract
  GET    '/api/crm/contracts/{id}'        -> getCrmContract
  POST   '/api/crm/contracts'             -> saveCrmContract
  DELETE '/api/crm/contracts/{id}'        -> deleteCrmContract
  POST   '/api/crm/contracts/{id}/submit' -> submitCrmContract
  POST   '/api/crm/contracts/{id}/approve' -> approveCrmContract
  POST   '/api/crm/contracts/{id}/reject' -> rejectCrmContract
  GET    '/api/crm/contract-config'        -> queryCrmContractConfig
  POST   '/api/crm/contract-config'        -> saveCrmContractConfig
  GET    '/api/crm/receivable-plans'       -> queryCrmReceivablePlan
  POST   '/api/crm/receivable-plans'       -> saveCrmReceivablePlan
  DELETE '/api/crm/receivable-plans/{id}'  -> deleteCrmReceivablePlan
  GET    '/api/crm/receivables'            -> queryCrmReceivable
  GET    '/api/crm/receivables/{id}'       -> getCrmReceivable
  POST   '/api/crm/receivables'            -> saveCrmReceivable
  DELETE '/api/crm/receivables/{id}'       -> deleteCrmReceivable
  POST   '/api/crm/receivables/{id}/submit' -> submitCrmReceivable
  POST   '/api/crm/receivables/{id}/approve' -> approveCrmReceivable
  POST   '/api/crm/receivables/{id}/reject' -> rejectCrmReceivable
  GET    '/api/crm/product-categories'     -> queryCrmProductCategory
  POST   '/api/crm/product-categories'     -> saveCrmProductCategory
  DELETE '/api/crm/product-categories/{id}' -> deleteCrmProductCategory
  GET    '/api/crm/products'               -> queryCrmProduct
  POST   '/api/crm/products'               -> saveCrmProduct
  DELETE '/api/crm/products/{id}'          -> deleteCrmProduct
  GET    '/api/crm/follow-up-records'      -> queryCrmFollowUpRecord
  POST   '/api/crm/follow-up-records'      -> saveCrmFollowUpRecord
  GET    '/api/crm/todos'                  -> queryCrmTodo
  POST   '/api/crm/todos'                  -> saveCrmTodo
  DELETE '/api/crm/todos/{id}'             -> deleteCrmTodo
  POST   '/api/crm/todos/{id}/complete'    -> completeCrmTodo
}

