  <form submit={useMutation('saveErpStockCheck')}>
    <input field="no" label="盘点单号" />
    <input field="checkTime" label="盘点时间" />
    <input field="warehouseId" label="仓库" />
    <input field="remark" label="备注" />
    <repeat field="items">
      <input field="productId" label="产品" />
      <input field="productUnitId" label="产品单位" />
      <input field="count" label="盘点数量" />
      <input field="systemCount" label="系统库存" />
      <input field="diffCount" label="差异数量" />
      <input field="remark" label="备注" />
    </repeat>
    <button text="保存" />
  </form>
}