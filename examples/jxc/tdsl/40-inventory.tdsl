// 进销存 · 库存查询功能域：进销存汇总表（跨四张明细表聚合 + 内存合并）
// 汇总口径：stock = 进货 - 进货退货 - 销货 + 销货退货

@export
logic inventorySummary(goodsCode: String): List<InventoryRow> {
  rows := new List<InventoryRow>();
  for (g in Goods.where(code like '%' + goodsCode + '%')) {
    inQty := 0;
    for (pi in PurchaseBillItem.where(goodsId = g.id)) {
      inQty = inQty + pi.qty;
    }
    inRetQty := 0;
    for (pi in PurchaseReturnItem.where(goodsId = g.id)) {
      inRetQty = inRetQty + pi.qty;
    }
    outQty := 0;
    for (pi in SalesBillItem.where(goodsId = g.id)) {
      outQty = outQty + pi.qty;
    }
    outRetQty := 0;
    for (pi in SalesReturnItem.where(goodsId = g.id)) {
      outRetQty = outRetQty + pi.qty;
    }
    row := new InventoryRow();
    row.goodsCode = g.code;
    row.goodsName = g.name;
    row.category = g.category;
    row.spec = g.spec;
    row.unit = g.unit;
    row.safetyStock = g.safetyStock;
    row.inQty = inQty;
    row.inRetQty = inRetQty;
    row.outQty = outQty;
    row.outRetQty = outRetQty;
    row.stock = inQty - inRetQty - outQty + outRetQty;
    rows.add(row);
  }
  return rows;
}

interface InventoryApi {
  GET '/api/inventory/summary' -> inventorySummary
}

// ---- 页面 ----

// @title('进销存汇总表') 已生成
@title('进销存汇总表')
@menu('库存查询')
page InventorySummary {
  <input field="goodsCode" label="商品编码" />
  <table dataSource={useQuery('inventorySummary')}>
    <column field="goodsCode" />
    <column field="goodsName" />
    <column field="category" />
    <column field="spec" />
    <column field="unit" />
    <column field="safetyStock" />
    <column field="inQty" />
    <column field="inRetQty" />
    <column field="outQty" />
    <column field="outRetQty" />
    <column field="stock" />
  </table>
}
