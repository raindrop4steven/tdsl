// 进销存 · 应收应付功能域：应付款/应收款 确认→开票→回款 状态推进 + 接口 + 页面
// 状态机（spec）：WAIT_CONFIRM → WAIT_INVOICE（确认）→ WAIT_PAY（开票）→ DONE（回款结清）

@export
logic searchPayables(billNo: String, status: PayStatus): List<Payable> {
  return Payable.where(billNo like '%' + billNo + '%', status = status);
}

@export
logic confirmPayable(id: Integer): Boolean {
  p := Payable.get(id);
  if (p.status !== PayStatus.WAIT_CONFIRM) {
    return false;
  }
  p.status = PayStatus.WAIT_INVOICE;
  p.save();
  return true;
}

@export
logic invoicePayable(id: Integer, invoiceNo: String): Boolean {
  p := Payable.get(id);
  p.invoiceNo = invoiceNo;
  p.status = PayStatus.WAIT_PAY;
  p.save();
  return true;
}

@export
logic payPayable(id: Integer, amount: Decimal): Boolean {
  p := Payable.get(id);
  p.paidAmount = p.paidAmount + amount;
  if (p.paidAmount >= p.amount) {
    p.status = PayStatus.DONE;
  }
  p.save();
  return true;
}

@export
logic searchReceivables(billNo: String, status: PayStatus): List<Receivable> {
  return Receivable.where(billNo like '%' + billNo + '%', status = status);
}

@export
logic confirmReceivable(id: Integer): Boolean {
  r := Receivable.get(id);
  if (r.status !== PayStatus.WAIT_CONFIRM) {
    return false;
  }
  r.status = PayStatus.WAIT_INVOICE;
  r.save();
  return true;
}

@export
logic invoiceReceivable(id: Integer, invoiceNo: String): Boolean {
  r := Receivable.get(id);
  r.invoiceNo = invoiceNo;
  r.status = PayStatus.WAIT_PAY;
  r.save();
  return true;
}

@export
logic payReceivable(id: Integer, amount: Decimal): Boolean {
  r := Receivable.get(id);
  r.paidAmount = r.paidAmount + amount;
  if (r.paidAmount >= r.amount) {
    r.status = PayStatus.DONE;
  }
  r.save();
  return true;
}

interface FinanceApi {
  GET  '/api/payables'           -> searchPayables
  POST '/api/payables/confirm'   -> confirmPayable
  POST '/api/payables/invoice'   -> invoicePayable
  POST '/api/payables/pay'       -> payPayable
  GET  '/api/receivables'        -> searchReceivables
  POST '/api/receivables/confirm' -> confirmReceivable
  POST '/api/receivables/invoice' -> invoiceReceivable
  POST '/api/receivables/pay'     -> payReceivable
}

// ---- 页面 ----

// @title('应付款列表') 已生成
@title('应付款列表')
@menu('应收应付')
page PayableList {
  <input field="billNo" label="关联单号" />
  <input field="status" label="状态" />
  <table dataSource={useQuery('searchPayables')}>
    <column field="billNo" title="关联进货单号" />
    <column field="supplierId" title="供应商" />
    <column field="amount" title="应付金额" />
    <column field="invoiceNo" title="发票号" />
    <column field="paidAmount" title="已付金额" />
    <column field="status" title="状态" />
    <button text="确认" action={useMutation('confirmPayable', row.id)} />
    <button text="开票" action={useMutation('invoicePayable', row.id)} />
    <button text="回款" action={useMutation('payPayable', row.id)} />
  </table>
}

// @title('应收款列表') 已生成
@title('应收款列表')
@menu('应收应付')
page ReceivableList {
  <input field="billNo" label="关联单号" />
  <input field="status" label="状态" />
  <table dataSource={useQuery('searchReceivables')}>
    <column field="billNo" title="关联销货单号" />
    <column field="customerId" title="客户" />
    <column field="amount" title="应收金额" />
    <column field="invoiceNo" title="发票号" />
    <column field="paidAmount" title="已收金额" />
    <column field="status" title="状态" />
    <button text="确认" action={useMutation('confirmReceivable', row.id)} />
    <button text="开票" action={useMutation('invoiceReceivable', row.id)} />
    <button text="回款" action={useMutation('payReceivable', row.id)} />
  </table>
}
