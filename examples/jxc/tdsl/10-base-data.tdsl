// 进销存 · 基础数据功能域：商品/供应商/客户 查询·保存·删除 + 接口 + 页面

// ---- 商品 ----

@export
function searchGoods(code: String, name: String, category: GoodsCategory): List<Goods> {
  return Goods.where(code like '%' + code + '%', name like '%' + name + '%', category = category);
}

@export
function saveGoods(input: GoodsInput): Goods {
  const g = new Goods();
  if (input.id !== null && input.id > 0) {
    const g = Goods.get(input.id);
  }
  g.code = input.code;
  g.name = input.name;
  g.category = input.category;
  g.spec = input.spec;
  g.origin = input.origin;
  g.unit = input.unit;
  g.purchasePrice = input.purchasePrice;
  g.salePrice = input.salePrice;
  g.safetyStock = input.safetyStock;
  g.remark = input.remark;
  g.save();
  return g;
}

@export
function deleteGoods(id: Integer): Boolean {
  const g = Goods.get(id);
  g.delete();
  return true;
}

// ---- 供应商 ----

@export
function searchSuppliers(name: String): List<Supplier> {
  return Supplier.where(name like '%' + name + '%');
}

@export
function saveSupplier(input: SupplierInput): Supplier {
  const s = new Supplier();
  if (input.id !== null && input.id > 0) {
    const s = Supplier.get(input.id);
  }
  s.name = input.name;
  s.shortName = input.shortName;
  s.creditCode = input.creditCode;
  s.contact = input.contact;
  s.phone = input.phone;
  s.address = input.address;
  s.invoiceAddress = input.invoiceAddress;
  s.invoicePhone = input.invoicePhone;
  s.bankName = input.bankName;
  s.bankAccount = input.bankAccount;
  s.remark = input.remark;
  s.save();
  return s;
}

@export
function deleteSupplier(id: Integer): Boolean {
  const s = Supplier.get(id);
  s.delete();
  return true;
}

// ---- 客户 ----

@export
function searchCustomers(name: String): List<Customer> {
  return Customer.where(name like '%' + name + '%');
}

@export
function saveCustomer(input: CustomerInput): Customer {
  const c = new Customer();
  if (input.id !== null && input.id > 0) {
    const c = Customer.get(input.id);
  }
  c.name = input.name;
  c.shortName = input.shortName;
  c.creditCode = input.creditCode;
  c.contact = input.contact;
  c.phone = input.phone;
  c.address = input.address;
  c.invoiceAddress = input.invoiceAddress;
  c.invoicePhone = input.invoicePhone;
  c.bankName = input.bankName;
  c.bankAccount = input.bankAccount;
  c.remark = input.remark;
  c.save();
  return c;
}

@export
function deleteCustomer(id: Integer): Boolean {
  const c = Customer.get(id);
  c.delete();
  return true;
}

interface BaseDataApi {
  GET    '/api/goods'           -> searchGoods
  POST   '/api/goods'           -> saveGoods
  DELETE '/api/goods/{id}'      -> deleteGoods
  GET    '/api/suppliers'       -> searchSuppliers
  POST   '/api/suppliers'       -> saveSupplier
  DELETE '/api/suppliers/{id}'  -> deleteSupplier
  GET    '/api/customers'       -> searchCustomers
  POST   '/api/customers'       -> saveCustomer
  DELETE '/api/customers/{id}'  -> deleteCustomer
}

// ---- 页面 ----

// @title('商品列表') 已生成
@title('商品列表')
@menu('基础数据')
page GoodsList {
  <input field="code" label="商品编码" />
  <input field="name" label="商品名称" />
  <input field="category" label="商品类别" />
  <table dataSource={useQuery('searchGoods')}>
    <column field="code" title="商品编码" />
    <column field="name" title="商品名称" />
    <column field="category" title="商品类别" />
    <column field="spec" title="规格型号" />
    <column field="unit" title="计量单位" />
    <column field="purchasePrice" title="采购单价" />
    <column field="salePrice" title="销售单价" />
    <column field="safetyStock" title="安全库存" />
    <button text="编辑" action={openDialog('GoodsEdit', row)} />
    <button text="删除" action={useMutation('deleteGoods', row.id)} />
  </table>
  <button text="新增商品" action={openDialog('GoodsEdit')} />
}

@title('商品编辑')
@menu('基础数据')
dialog GoodsEdit {
  <form submit={useMutation('saveGoods')}>
    <input field="code" label="商品编码" />
    <input field="name" label="商品名称" />
    <input field="category" label="商品类别" />
    <input field="spec" label="规格型号" />
    <input field="origin" label="产地" />
    <input field="unit" label="计量单位" />
    <input field="purchasePrice" label="采购单价" />
    <input field="salePrice" label="销售单价" />
    <input field="safetyStock" label="安全库存" />
    <input field="remark" label="备注" />
    <button text="保存" />
  </form>
}

