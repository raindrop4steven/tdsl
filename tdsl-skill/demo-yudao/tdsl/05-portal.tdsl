// 芋道 ERP/CRM · 门户看板（dev/46-48）：统计指标（条件聚合）+ 轮播 + 进度 + 只读列表
// 说明：@role 语法已支持（语言面保留），外壳暂不做角色切换——门户面向全员展示

// ---- 统计逻辑（C1 条件聚合：where(...).aggregate(...)） ----

@export
function countErpPurchaseOrder(): Integer {
  return PurchaseOrder.aggregate(count());
}

@export
function countErpPurchaseInPending(): Integer {
  return PurchaseIn.where(status = DocStatus.UNAUDIT).aggregate(count());
}

@export
function sumErpStockCount(): Decimal {
  return Stock.aggregate(sum(count));
}

@export
function sumErpSaleAmount(): Decimal {
  return SaleOrder.aggregate(sum(totalPrice));
}

@export
function countErpSaleOutPending(): Integer {
  return SaleOut.where(status = DocStatus.UNAUDIT).aggregate(count());
}

@export
function sumErpSaleOutReceipt(): Decimal {
  return SaleOut.aggregate(sum(receiptPrice));
}

@export
function countErpProduct(): Integer {
  return Product.aggregate(count());
}

@export
function countErpWarehouse(): Integer {
  return Warehouse.aggregate(count());
}

@export
function sumErpPurchaseAmount(): Decimal {
  return PurchaseOrder.aggregate(sum(totalPrice));
}

@export
function countErpPurchaseReturnPending(): Integer {
  return PurchaseReturn.where(status = DocStatus.UNAUDIT).aggregate(count());
}

@export
function countCrmClue(): Integer {
  return CrmClue.aggregate(count());
}

@export
function countCrmCustomer(): Integer {
  return CrmCustomer.aggregate(count());
}

@export
function countCrmBusiness(): Integer {
  return CrmBusiness.aggregate(count());
}

@export
function countCrmContract(): Integer {
  return CrmContract.aggregate(count());
}

@export
function countCrmReceivablePending(): Integer {
  return CrmReceivable.where(auditStatus = CrmAuditStatus.UNSUBMIT).aggregate(count());
}

@export
function countCrmCustomerLocked(): Integer {
  return CrmCustomer.where(lockStatus = LockStatus.LOCKED).aggregate(count());
}

interface PortalApi {
  GET '/api/portal/stats/purchase-orders'   -> countErpPurchaseOrder
  GET '/api/portal/stats/purchase-in-pending' -> countErpPurchaseInPending
  GET '/api/portal/stats/purchase-return-pending' -> countErpPurchaseReturnPending
  GET '/api/portal/stats/purchase-amount'   -> sumErpPurchaseAmount
  GET '/api/portal/stats/stock-count'       -> sumErpStockCount
  GET '/api/portal/stats/sale-amount'       -> sumErpSaleAmount
  GET '/api/portal/stats/sale-out-pending'  -> countErpSaleOutPending
  GET '/api/portal/stats/sale-out-receipt'  -> sumErpSaleOutReceipt
  GET '/api/portal/stats/product-count'     -> countErpProduct
  GET '/api/portal/stats/warehouse-count'   -> countErpWarehouse
  GET '/api/portal/stats/crm-clues'         -> countCrmClue
  GET '/api/portal/stats/crm-customers'     -> countCrmCustomer
  GET '/api/portal/stats/crm-customers-locked' -> countCrmCustomerLocked
  GET '/api/portal/stats/crm-businesses'    -> countCrmBusiness
  GET '/api/portal/stats/crm-contracts'     -> countCrmContract
  GET '/api/portal/stats/crm-receivable-pending' -> countCrmReceivablePending
}

// ---- 经营总览 ----

@title('经营总览') @menu('门户')
page bossDashboard {
  <carousel autoplay={true}>
    <item title="九月采购节" text="办公设备采购满 10 万返 5%，截止 9/30" />
    <item title="库存盘点通知" text="请于 9/30 前完成华东一号仓盘点" />
    <item title="新品上架" text="联想拯救者 Y9000P 已入库，欢迎下单" />
  </carousel>
  <row>
    <col span={6}><statistic title="销售订单金额" suffix="元" color="blue" dataSource={useQuery('sumErpSaleAmount')} /></col>
    <col span={6}><statistic title="采购订单金额" suffix="元" color="green" dataSource={useQuery('sumErpPurchaseAmount')} /></col>
    <col span={6}><statistic title="库存总量" suffix="件" color="orange" dataSource={useQuery('sumErpStockCount')} /></col>
    <col span={6}><statistic title="在售产品" suffix="款" color="purple" dataSource={useQuery('countErpProduct')} /></col>
  </row>
  <row>
    <col span={6}><statistic title="采购订单数" suffix="单" color="cyan" dataSource={useQuery('countErpPurchaseOrder')} /></col>
    <col span={6}><statistic title="待审批入库" suffix="单" color="red" dataSource={useQuery('countErpPurchaseInPending')} /></col>
    <col span={6}><statistic title="待审批出库" suffix="单" color="magenta" dataSource={useQuery('countErpSaleOutPending')} /></col>
    <col span={6}><statistic title="已收金额" suffix="元" color="gold" dataSource={useQuery('sumErpSaleOutReceipt')} /></col>
  </row>
  <row>
    <col span={8}><progress title="年度销售目标完成率" percent={72} color="blue" /></col>
    <col span={8}><progress title="采购及时到货率" percent={88} color="green" /></col>
    <col span={8}><progress title="库存周转达成率" percent={64} color="orange" /></col>
  </row>
  <row>
    <col span={12}>
      <list dataSource={useQuery('queryErpPurchaseIn')} title="近期入库">
        <item primary={true} field="no" title="入库单号" />
        <item field="inTime" title="入库时间" />
        <item extra={true} field="totalPrice" title="金额" color="green" />
      </list>
    </col>
    <col span={12}>
      <list dataSource={useQuery('queryErpSaleOrder')} title="近期销售">
        <item primary={true} field="no" title="销售单号" />
        <item field="orderTime" title="下单时间" />
        <item extra={true} field="totalPrice" title="金额" color="blue" />
      </list>
    </col>
  </row>
  <row>
    <col span={12}>
      <list dataSource={useQuery('queryErpStockRecord')} title="库存变动动态">
        <item primary={true} field="bizNo" title="来源单号" />
        <item field="count" title="变动量" />
        <item extra={true} field="totalCount" title="结存" color="orange" />
      </list>
    </col>
    <col span={12}>
      <list dataSource={useQuery('queryCrmClue')} title="最新线索">
        <item primary={true} field="name" title="线索名称" />
        <item field="mobile" title="手机" />
        <item extra={true} field="followUpStatus" title="跟进" color="purple" />
      </list>
    </col>
  </row>
}

