{
  "name": "@tdsl/eval",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "C4 评测基线：spec → LLM → TDSL → 编译 → 双端 build 的自动化采集（dev/28 C4）",
  "main": "src/index.ts",
  "scripts": {
    "eval": "tsx src/run.ts",
    "eval:smoke": "tsx src/run.ts --skip-build",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@tdsl/codegen-java": "*",
    "@tdsl/codegen-react": "*",
    "@tdsl/core": "*",
    "@tdsl/llm": "*",
    "@tdsl/parser": "*",
    "@tdsl/typecheck": "*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.4"
  }
}
