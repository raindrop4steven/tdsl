@datasource('defaultDS')

entity Goods {
  id: Integer @pk;
  goodsCode: String;
  goodsName: String;
  category: String;
  spec: String;
  unit: String;
  safetyStock: Decimal;
  inQty: Decimal;
  inRetQty: Decimal;
  outQty: Decimal;
  outRetQty: Decimal;
  stock: Decimal;
}

@export
function inventorySummary(goodsCode: String): List<Goods> {
  if (goodsCode === null) {
    return Goods.all;
  }
  return Goods.where(goodsCode like '%' + goodsCode + '%').orderBy(goodsCode asc);
}

interface InventoryApi {
  GET '/api/inventory/summary' -> inventorySummary
}

page InventorySummary {
  <table dataSource={useQuery('inventorySummary')}>
    <column field="goodsCode" />
    <column field="goodsName" />
    <column field="category" />
    <column field="spec" />
    <column field="unit" />
    <column field="safetyStock" />
    <column field="inQty" />
    <column field="inRetQty" />
    <column field="outQty" />
    <column field="outRetQty" />
    <column field="stock" />
  </table>
  <form submit={useMutation('inventorySummary')}>
    <input field="goodsCode" />
    <button text="查询" />
  </form>
}