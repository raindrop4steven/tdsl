@datasource('defaultDS')

enum PayStatus { WAIT_CONFIRM, WAIT_INVOICE, WAIT_PAY, DONE }

entity Payable {
  id: Integer @pk;
  billNo: String;
  supplierId: Integer;
  amount: Decimal;
  invoiceNo: String @nullable;
  paidAmount: Decimal @nullable;
  status: PayStatus;
  remark: String @nullable;
}

entity Receivable {
  id: Integer @pk;
  billNo: String;
  customerId: Integer;
  amount: Decimal;
  invoiceNo: String @nullable;
  paidAmount: Decimal @nullable;
  status: PayStatus;
  remark: String @nullable;
}

@export
function searchPayables(billNo: String, status: PayStatus): List<Payable> {
  return Payable.where(billNo like '%' + billNo + '%', status = status).orderBy(id desc);
}

@export
function confirmPayable(id: Integer): Payable {
  const p = Payable.get(id);
  p.status = PayStatus.WAIT_INVOICE;
  p.save();
  return p;
}

@export
function invoicePayable(id: Integer, invoiceNo: String): Payable {
  const p = Payable.get(id);
  p.invoiceNo = invoiceNo;
  p.status = PayStatus.WAIT_PAY;
  p.save();
  return p;
}

@export
function payPayable(id: Integer, paidAmount: Decimal): Payable {
  const p = Payable.get(id);
  p.paidAmount = paidAmount;
  if (paidAmount >= p.amount) {
    p.status = PayStatus.DONE;
  }
  p.save();
  return p;
}

@export
function searchReceivables(billNo: String, status: PayStatus): List<Receivable> {
  return Receivable.where(billNo like '%' + billNo + '%', status = status).orderBy(id desc);
}

@export
function confirmReceivable(id: Integer): Receivable {
  const r = Receivable.get(id);
  r.status = PayStatus.WAIT_INVOICE;
  r.save();
  return r;
}

@export
function invoiceReceivable(id: Integer, invoiceNo: String): Receivable {
  const r = Receivable.get(id);
  r.invoiceNo = invoiceNo;
  r.status = PayStatus.WAIT_PAY;
  r.save();
  return r;
}

@export
function payReceivable(id: Integer, paidAmount: Decimal): Receivable {
  const r = Receivable.get(id);
  r.paidAmount = paidAmount;
  if (paidAmount >= r.amount) {
    r.status = PayStatus.DONE;
  }
  r.save();
  return r;
}

interface FinanceApi {
  GET    '/api/finance/payables/search'   -> searchPayables
  POST   '/api/finance/payables/confirm'  -> confirmPayable
  POST   '/api/finance/payables/invoice'  -> invoicePayable
  POST   '/api/finance/payables/pay'      -> payPayable
  GET    '/api/finance/receivables/search'  -> searchReceivables
  POST   '/api/finance/receivables/confirm' -> confirmReceivable
  POST   '/api/finance/receivables/invoice' -> invoiceReceivable
  POST   '/api/finance/receivables/pay'     -> payReceivable
}

page PayableList {
  <table dataSource={useQuery('searchPayables')}>
    <column field="billNo" />
    <column field="supplierId" />
    <column field="amount" />
    <column field="invoiceNo" />
    <column field="paidAmount" />
    <column field="status" />
    <button text="确认" action={useMutation('confirmPayable', row.id)} />
    <button text="开票" action={openDialog('InvoicePayable', row.id)} />
    <button text="回款" action={openDialog('PayPayable', row.id)} />
  </table>
}

dialog InvoicePayable {
  <form submit={useMutation('invoicePayable', row.id)}>
    <input field="invoiceNo" />
    <button text="提交" />
  </form>
}

dialog PayPayable {
  <form submit={useMutation('payPayable', row.id)}>
    <input field="paidAmount" />
    <button text="提交" />
  </form>
}

page ReceivableList {
  <table dataSource={useQuery('searchReceivables')}>
    <column field="billNo" />
    <column field="customerId" />
    <column field="amount" />
    <column field="invoiceNo" />
    <column field="paidAmount" />
    <column field="status" />
    <button text="确认" action={useMutation('confirmReceivable', row.id)} />
    <button text="开票" action={openDialog('InvoiceReceivable', row.id)} />
    <button text="回款" action={openDialog('PayReceivable', row.id)} />
  </table>
}

dialog InvoiceReceivable {
  <form submit={useMutation('invoiceReceivable', row.id)}>
    <input field="invoiceNo" />
    <button text="提交" />
  </form>
}

dialog PayReceivable {
  <form submit={useMutation('payReceivable', row.id)}>
    <input field="paidAmount" />
    <button text="提交" />
  </form>
}