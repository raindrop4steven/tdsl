@datasource('defaultDS')

enum GoodsCategory { FOOD, DAILY, CLOTH, OTHER }

enum Unit { PIECE, KILOGRAM, BOX, BOTTLE }

entity Goods {
  id: Integer @pk;
  code: String;
  name: String;
  category: GoodsCategory;
  spec: String @nullable;
  origin: String @nullable;
  unit: Unit;
  purchasePrice: Decimal;
  salePrice: Decimal;
  safetyStock: Integer @nullable;
  remark: String @nullable;
}

entity Supplier {
  id: Integer @pk;
  name: String;
  shortName: String @nullable;
  creditCode: String;
  contact: String @nullable;
  phone: String @nullable;
  address: String @nullable;
  invoiceAddress: String @nullable;
  invoicePhone: String @nullable;
  bankName: String @nullable;
  bankAccount: String @nullable;
  remark: String @nullable;
}

entity Customer {
  id: Integer @pk;
  name: String;
  shortName: String @nullable;
  creditCode: String;
  contact: String @nullable;
  phone: String @nullable;
  address: String @nullable;
  invoiceAddress: String @nullable;
  invoicePhone: String @nullable;
  bankName: String @nullable;
  bankAccount: String @nullable;
  remark: String @nullable;
}

struct GoodsInput {
  id: Integer @nullable;
  code: String;
  name: String;
  category: GoodsCategory;
  spec: String @nullable;
  origin: String @nullable;
  unit: Unit;
  purchasePrice: Decimal;
  salePrice: Decimal;
  safetyStock: Integer @nullable;
  remark: String @nullable;
}

struct SupplierInput {
  id: Integer @nullable;
  name: String;
  shortName: String @nullable;
  creditCode: String;
  contact: String @nullable;
  phone: String @nullable;
  address: String @nullable;
  invoiceAddress: String @nullable;
  invoicePhone: String @nullable;
  bankName: String @nullable;
  bankAccount: String @nullable;
  remark: String @nullable;
}

struct CustomerInput {
  id: Integer @nullable;
  name: String;
  shortName: String @nullable;
  creditCode: String;
  contact: String @nullable;
  phone: String @nullable;
  address: String @nullable;
  invoiceAddress: String @nullable;
  invoicePhone: String @nullable;
  bankName: String @nullable;
  bankAccount: String @nullable;
  remark: String @nullable;
}

@export
function searchGoods(code: String, name: String, category: GoodsCategory): List<Goods> {
  return Goods.where(code like '%' + code + '%', name like '%' + name + '%', category = category);
}

@export
function saveGoods(input: GoodsInput): Goods {
  let goods = new Goods();
  if (input.id !== null) {
    goods = Goods.get(input.id);
  }
  goods.code = input.code;
  goods.name = input.name;
  goods.category = input.category;
  goods.spec = input.spec;
  goods.origin = input.origin;
  goods.unit = input.unit;
  goods.purchasePrice = input.purchasePrice;
  goods.salePrice = input.salePrice;
  goods.safetyStock = input.safetyStock;
  goods.remark = input.remark;
  goods.save();
  return goods;
}

@export
function deleteGoods(id: Integer): Boolean {
  const goods = Goods.get(id);
  goods.delete();
  return true;
}

@export
function searchSuppliers(name: String): List<Supplier> {
  return Supplier.where(name like '%' + name + '%');
}

@export
function saveSupplier(input: SupplierInput): Supplier {
  let supplier = new Supplier();
  if (input.id !== null) {
    supplier = Supplier.get(input.id);
  }
  supplier.name = input.name;
  supplier.shortName = input.shortName;
  supplier.creditCode = input.creditCode;
  supplier.contact = input.contact;
  supplier.phone = input.phone;
  supplier.address = input.address;
  supplier.invoiceAddress = input.invoiceAddress;
  supplier.invoicePhone = input.invoicePhone;
  supplier.bankName = input.bankName;
  supplier.bankAccount = input.bankAccount;
  supplier.remark = input.remark;
  supplier.save();
  return supplier;
}

@export
function deleteSupplier(id: Integer): Boolean {
  const supplier = Supplier.get(id);
  supplier.delete();
  return true;
}

@export
function searchCustomers(name: String): List<Customer> {
  return Customer.where(name like '%' + name + '%');
}

@export
function saveCustomer(input: CustomerInput): Customer {
  let customer = new Customer();
  if (input.id !== null) {
    customer = Customer.get(input.id);
  }
  customer.name = input.name;
  customer.shortName = input.shortName;
  customer.creditCode = input.creditCode;
  customer.contact = input.contact;
  customer.phone = input.phone;
  customer.address = input.address;
  customer.invoiceAddress = input.invoiceAddress;
  customer.invoicePhone = input.invoicePhone;
  customer.bankName = input.bankName;
  customer.bankAccount = input.bankAccount;
  customer.remark = input.remark;
  customer.save();
  return customer;
}

@export
function deleteCustomer(id: Integer): Boolean {
  const customer = Customer.get(id);
  customer.delete();
  return true;
}

interface GoodsApi {
  GET    '/api/goods'         -> searchGoods
  POST   '/api/goods'         -> saveGoods
  DELETE '/api/goods/{id}'    -> deleteGoods
}

interface SupplierApi {
  GET    '/api/suppliers'      -> searchSuppliers
  POST   '/api/suppliers'      -> saveSupplier
  DELETE '/api/suppliers/{id}' -> deleteSupplier
}

interface CustomerApi {
  GET    '/api/customers'      -> searchCustomers
  POST   '/api/customers'      -> saveCustomer
  DELETE '/api/customers/{id}' -> deleteCustomer
}

page GoodsList {
  <table dataSource={useQuery('searchGoods')}>
    <column field="code" />
    <column field="name" />
    <column field="category" />
    <column field="spec" />
    <column field="unit" />
    <column field="purchasePrice" />
    <column field="salePrice" />
    <column field="safetyStock" />
    <button text="编辑" action={openDialog('GoodsEdit')} />
    <button text="删除" action={useMutation('deleteGoods', row.id)} />
  </table>
  <button text="新增商品" action={openDialog('GoodsEdit')} />
}

dialog GoodsEdit {
  <form submit={useMutation('saveGoods')}>
    <input field="code" />
    <input field="name" />
    <input field="category" />
    <input field="spec" />
    <input field="origin" />
    <input field="unit" />
    <input field="purchasePrice" />
    <input field="salePrice" />
    <input field="safetyStock" />
    <input field="remark" />
    <button text="保存" />
  </form>
}

page SupplierList {
  <table dataSource={useQuery('searchSuppliers')}>
    <column field="name" />
    <column field="shortName" />
    <column field="contact" />
    <column field="phone" />
    <column field="creditCode" />
    <column field="address" />
    <button text="编辑" action={openDialog('SupplierEdit')} />
    <button text="删除" action={useMutation('deleteSupplier', row.id)} />
  </table>
  <button text="新增供应商" action={openDialog('SupplierEdit')} />
}

dialog SupplierEdit {
  <form submit={useMutation('saveSupplier')}>
    <input field="name" />
    <input field="shortName" />
    <input field="creditCode" />
    <input field="contact" />
    <input field="phone" />
    <input field="address" />
    <input field="invoiceAddress" />
    <input field="invoicePhone" />
    <input field="bankName" />
    <input field="bankAccount" />
    <input field="remark" />
    <button text="保存" />
  </form>
}

page CustomerList {
  <table dataSource={useQuery('searchCustomers')}>
    <column field="name" />
    <column field="shortName" />
    <column field="contact" />
    <column field="phone" />
    <column field="creditCode" />
    <column field="address" />
    <button text="编辑" action={openDialog('CustomerEdit')} />
    <button text="删除" action={useMutation('deleteCustomer', row.id)} />
  </table>
  <button text="新增客户" action={openDialog('CustomerEdit')} />
}

dialog CustomerEdit {
  <form submit={useMutation('saveCustomer')}>
    <input field="name" />
    <input field="shortName" />
    <input field="creditCode" />
    <input field="contact" />
    <input field="phone" />
    <input field="address" />
    <input field="invoiceAddress" />
    <input field="invoicePhone" />
    <input field="bankName" />
    <input field="bankAccount" />
    <input field="remark" />
    <button text="保存" />
  </form>
}