@datasource('defaultDS')

enum GoodsCategory { FOOD, DAILY, CLOTH, OTHER }
enum Unit { PIECE, KILOGRAM, BOX, BOTTLE }
enum SettleMode { CASH, ACCOUNT }
enum DocStatus { DRAFT, SUBMITTED }

entity SalesBill {
  id: Integer @pk;
  billNo: String;
  status: DocStatus;
  billDate: DateTime;
  customerId: Integer;
  contractNo: String @nullable;
  invoiceNo: String @nullable;
  logisticsCompany: String @nullable;
  logisticsNo: String @nullable;
  totalAmount: Decimal @nullable;
  settleMode: SettleMode;
  remark: String @nullable;
}

entity SalesBillItem {
  id: Integer @pk;
  billId: Integer;
  goodsId: Integer;
  goodsCode: String @nullable;
  goodsName: String @nullable;
  category: GoodsCategory @nullable;
  spec: String @nullable;
  unit: Unit @nullable;
  qty: Integer;
  price: Decimal;
  amount: Decimal @nullable;
  remark: String @nullable;
}

entity SalesReturnBill {
  id: Integer @pk;
  billNo: String;
  status: DocStatus;
  returnDate: DateTime;
  sourceBillNo: String;
  totalAmount: Decimal @nullable;
  remark: String @nullable;
}

struct SalesBillInput {
  id: Integer;
  billNo: String;
  billDate: DateTime;
  customerId: Integer;
  contractNo: String;
  invoiceNo: String;
  logisticsCompany: String;
  logisticsNo: String;
  settleMode: SettleMode;
  remark: String;
  items: List<SalesBillItemInput>;
}

struct SalesBillItemInput {
  id: Integer;
  goodsId: Integer;
  qty: Integer;
  price: Decimal;
}

@export
function searchSalesBills(billNo: String, status: DocStatus): List<SalesBill> {
  return SalesBill.where(billNo like '%' + billNo + '%', status = status).orderBy(id desc);
}

@export
function saveSalesBill(input: SalesBillInput): SalesBill {
  let bill: SalesBill = null;
  if (input.id === null) {
    bill = new SalesBill();
    bill.status = DocStatus.DRAFT;
  } else {
    bill = SalesBill.get(input.id);
    if (bill.status === DocStatus.SUBMITTED) {
      throw '已提交单据不可编辑';
    }
    for (const old of SalesBillItem.where(billId = bill.id)) {
      old.delete();
    }
  }
  bill.billNo = input.billNo;
  bill.billDate = input.billDate;
  bill.customerId = input.customerId;
  bill.contractNo = input.contractNo;
  bill.invoiceNo = input.invoiceNo;
  bill.logisticsCompany = input.logisticsCompany;
  bill.logisticsNo = input.logisticsNo;
  bill.settleMode = input.settleMode;
  bill.remark = input.remark;
  bill.totalAmount = 0;
  bill.save();
  for (const it of input.items) {
    const item = new SalesBillItem();
    item.billId = bill.id;
    item.goodsId = it.goodsId;
    item.qty = it.qty;
    item.price = it.price;
    item.amount = it.qty * it.price;
    item.save();
    bill.totalAmount = bill.totalAmount + it.qty * it.price;
  }
  bill.save();
  return bill;
}

@export
function submitSalesBill(input: SalesBillInput): SalesBill {
  const bill = SalesBill.get(input.id);
  if (bill.status === DocStatus.SUBMITTED) {
    throw '已提交单据不可重复提交';
  }
  bill.status = DocStatus.SUBMITTED;
  bill.save();
  return bill;
}

@export
function deleteSalesBill(id: Integer): Boolean {
  const bill = SalesBill.get(id);
  if (bill.status === DocStatus.SUBMITTED) {
    throw '已提交单据不可删除';
  }
  for (const it of SalesBillItem.where(billId = id)) {
    it.delete();
  }
  bill.delete();
  return true;
}

@export
function copySalesBill(id: Integer): SalesBill {
  const src = SalesBill.get(id);
  const bill = new SalesBill();
  bill.billNo = src.billNo + '-COPY';
  bill.status = DocStatus.DRAFT;
  bill.billDate = src.billDate;
  bill.customerId = src.customerId;
  bill.contractNo = src.contractNo;
  bill.invoiceNo = src.invoiceNo;
  bill.logisticsCompany = src.logisticsCompany;
  bill.logisticsNo = src.logisticsNo;
  bill.settleMode = src.settleMode;
  bill.remark = src.remark;
  bill.totalAmount = src.totalAmount;
  bill.save();
  for (const it of SalesBillItem.where(billId = id)) {
    const item = new SalesBillItem();
    item.billId = bill.id;
    item.goodsId = it.goodsId;
    item.goodsCode = it.goodsCode;
    item.goodsName = it.goodsName;
    item.category = it.category;
    item.spec = it.spec;
    item.unit = it.unit;
    item.qty = it.qty;
    item.price = it.price;
    item.amount = it.amount;
    item.remark = it.remark;
    item.save();
  }
  return bill;
}

@export
function returnSalesBill(id: Integer): SalesReturnBill {
  const src = SalesBill.get(id);
  const ret = new SalesReturnBill();
  ret.billNo = 'RT' + src.billNo;
  ret.status = DocStatus.DRAFT;
  ret.returnDate = src.billDate;
  ret.sourceBillNo = src.billNo;
  ret.totalAmount = src.totalAmount;
  ret.save();
  return ret;
}

@export
function searchSalesReturns(billNo: String): List<SalesReturnBill> {
  return SalesReturnBill.where(billNo like '%' + billNo + '%').orderBy(id desc);
}

interface SalesApi {
  GET    '/api/sales/bills'            -> searchSalesBills
  POST   '/api/sales/bills'            -> saveSalesBill
  POST   '/api/sales/bills/submit'     -> submitSalesBill
  DELETE '/api/sales/bills/{id}'       -> deleteSalesBill
  POST   '/api/sales/bills/{id}/copy'  -> copySalesBill
  POST   '/api/sales/bills/{id}/return' -> returnSalesBill
  GET    '/api/sales/returns'          -> searchSalesReturns
}

page SalesBillList {
  <table dataSource={useQuery('searchSalesBills')}>
    <column field="billNo" />
    <column field="billDate" />
    <column field="customerId" />
    <column field="status" />
    <column field="totalAmount" />
    <column field="settleMode" />
    <button text="编辑" action={openDialog('SalesBillEdit', row.id)} />
    <button text="删除" action={useMutation('deleteSalesBill', row.id)} />
    <button text="复制" action={useMutation('copySalesBill', row.id)} />
    <button text="整单退货" action={useMutation('returnSalesBill', row.id)} />
  </table>
  <button text="新增销货单" action={openDialog('SalesBillEdit')} />
}

dialog SalesBillEdit {
  <form submit={useMutation('saveSalesBill')}>
    <input field="billNo" />
    <input field="billDate" />
    <input field="customerId" />
    <input field="contractNo" />
    <input field="invoiceNo" />
    <input field="logisticsCompany" />
    <input field="logisticsNo" />
    <input field="settleMode" />
    <input field="remark" />
    <repeat field="items">
      <input field="goodsId" />
      <input field="qty" />
      <input field="price" />
    </repeat>
    <button text="暂存" />
    <button text="提交" action={useMutation('submitSalesBill')} />
  </form>
}

page SalesReturnList {
  <table dataSource={useQuery('searchSalesReturns')}>
    <column field="billNo" />
    <column field="returnDate" />
    <column field="sourceBillNo" />
    <column field="totalAmount" />
    <column field="status" />
  </table>
}