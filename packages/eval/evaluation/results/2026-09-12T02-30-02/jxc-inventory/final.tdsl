@datasource('defaultDS')

entity InventorySummary {
  id: Integer @pk;
  goodsCode: String;
  goodsName: String;
  category: String;
  spec: String;
  unit: String;
  safetyStock: Decimal;
  inQty: Decimal;
  inRetQty: Decimal;
  outQty: Decimal;
  outRetQty: Decimal;
  stock: Decimal;
}

@export
function inventorySummary(goodsCode: String): List<InventorySummary> {
  if (goodsCode === null) {
    return InventorySummary.all;
  }
  return InventorySummary.where(goodsCode like '%' + goodsCode + '%');
}

interface InventoryApi {
  GET '/api/inventory/summary' -> inventorySummary
}

page InventorySummary {
  <form>
    <input field="goodsCode" />
    <button text="查询" action={useQuery('inventorySummary', goodsCode)} />
  </form>
  <table dataSource={useQuery('inventorySummary', goodsCode)}>
    <column field="goodsCode" />
    <column field="goodsName" />
    <column field="category" />
    <column field="spec" />
    <column field="unit" />
    <column field="safetyStock" />
    <column field="inQty" />
    <column field="inRetQty" />
    <column field="outQty" />
    <column field="outRetQty" />
    <column field="stock" />
  </table>
}