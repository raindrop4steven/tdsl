// 进销存管理系统（jxc）—— 库存查询 / 进销存汇总
@datasource('defaultDS')

entity Goods {
  id: Integer @pk;
  goodsCode: String @unique;
  goodsName: String;
  category: String;
  spec: String;
  unit: String;
  safetyStock: Decimal;
}

// 出入库流水：type 取值 IN(入库) / IN_RET(入库退货) / OUT(出库) / OUT_RET(出库退货)
// status 取值 DRAFT(暂存) / SUBMITTED(已提交)，提交后不可编辑删除，汇总仅统计已提交单据
entity StockRecord {
  id: Integer @pk;
  goodsCode: String;
  type: String;
  qty: Decimal;
  status: String;
  recordDate: Date;
}

struct InventorySummaryRow {
  goodsCode: String;
  goodsName: String;
  category: String;
  spec: String;
  unit: String;
  safetyStock: Decimal;
  inQty: Decimal;
  inRetQty: Decimal;
  outQty: Decimal;
  outRetQty: Decimal;
  stock: Decimal;
}

@export
function inventorySummary(goodsCode: String): List<InventorySummaryRow> {
  const result: List<InventorySummaryRow> = [];
  const goodsList = Goods.where(goodsCode like '%' + goodsCode + '%');
  for (const g of goodsList) {
    const row = new InventorySummaryRow();
    row.goodsCode = g.goodsCode;
    row.goodsName = g.goodsName;
    row.category = g.category;
    row.spec = g.spec;
    row.unit = g.unit;
    row.safetyStock = g.safetyStock;
    let inQty: Decimal = 0;
    for (const r of StockRecord.where(goodsCode = g.goodsCode, type = 'IN', status = 'SUBMITTED')) {
      inQty = inQty + r.qty;
    }
    row.inQty = inQty;
    let inRetQty: Decimal = 0;
    for (const r of StockRecord.where(goodsCode = g.goodsCode, type = 'IN_RET', status = 'SUBMITTED')) {
      inRetQty = inRetQty + r.qty;
    }
    row.inRetQty = inRetQty;
    let outQty: Decimal = 0;
    for (const r of StockRecord.where(goodsCode = g.goodsCode, type = 'OUT', status = 'SUBMITTED')) {
      outQty = outQty + r.qty;
    }
    row.outQty = outQty;
    let outRetQty: Decimal = 0;
    for (const r of StockRecord.where(goodsCode = g.goodsCode, type = 'OUT_RET', status = 'SUBMITTED')) {
      outRetQty = outRetQty + r.qty;
    }
    row.outRetQty = outRetQty;
    row.stock = row.inQty - row.inRetQty - row.outQty + row.outRetQty;
    result.add(row);
  }
  return result;
}

interface InventoryApi {
  GET '/api/inventory/summary' -> inventorySummary
}

page InventorySummary {
  <form submit={useQuery('inventorySummary')}>
    <input field="goodsCode" />
    <button text="查询" />
  </form>
  <table dataSource={useQuery('inventorySummary')}>
    <column field="goodsCode" />
    <column field="goodsName" />
    <column field="category" />
    <column field="spec" />
    <column field="unit" />
    <column field="safetyStock" />
    <column field="inQty" />
    <column field="inRetQty" />
    <column field="outQty" />
    <column field="outRetQty" />
    <column field="stock" />
  </table>
}